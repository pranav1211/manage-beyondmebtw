{
  "name": "manage-beyondmebtw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manage — the Beyond Me ecosystem control/data plane, with the Argus deployment execution service. Phase 3 rebuild.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "dev:api": "node services/manage-api/index.js",
    "dev:argus": "node services/argus/argus.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "validate": "node scripts/validate.js",
    "verify": "npm run lint && npm run validate && npm test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "vite": "^5.4.11"
  }
}
