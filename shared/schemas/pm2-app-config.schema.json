{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://manage.beyondmebtw.com/schemas/pm2-app-config.json",
  "title": "PM2 application configuration metadata",
  "description": "Desired PM2 configuration the future Argus reconciler needs for one application. Describes process shape and environment variable NAMES only. Secret VALUES never appear here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "application",
    "processes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "application": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "script",
          "cwd",
          "execMode"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "description": "Entry script path."
          },
          "cwd": {
            "type": "string",
            "pattern": "^/.+",
            "description": "Absolute working directory on the server."
          },
          "interpreter": {
            "type": [
              "string",
              "null"
            ],
            "default": "node"
          },
          "execMode": {
            "type": "string",
            "enum": [
              "fork",
              "cluster"
            ]
          },
          "instances": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "port": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 65535
          },
          "envRefs": {
            "type": "array",
            "description": "Environment variable NAMES this process requires. Values live outside Git.",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "envFile": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^/infrastructure/env/[A-Za-z0-9][A-Za-z0-9._-]*\\.env$",
            "description": "Absolute path of the env file the process loads (path only, never values)."
          }
        }
      }
    }
  }
}
