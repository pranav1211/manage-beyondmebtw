# Manage / Argus environment — EXAMPLE ONLY
# Copy to `.env` and fill with real values locally. NEVER commit `.env`.
# Names + dummy placeholders only; no real secrets belong in this file.

# ── Runtime mode ─────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

# ── Manage API service ───────────────────────────────────────────────
MANAGE_API_PORT=7000
# Server-side session signing secret (replaces the legacy shared plaintext key).
MANAGE_SESSION_SECRET=replace-me-session-secret

# ── Argus execution service (localhost-only) ─────────────────────────
ARGUS_PORT=6040
# Bind address — MUST remain localhost; Argus is never public.
ARGUS_BIND=127.0.0.1
# Shared secret authenticating Manage API -> Argus internal calls.
ARGUS_INTERNAL_TOKEN=replace-me-argus-internal-token

# ── Canonical state roots (defaults are repo-relative) ───────────────
# DATA_ROOT=./data
# CONTENT_ROOT=./content

# ── Webhook verification (per-target secrets live outside Git) ────────
# Default webhook secret for ordinary projects (Argus). Real value is
# supplied via the server-private env, not committed here.
WEBHOOK_DEFAULT_SECRET=replace-me-default-webhook-secret
